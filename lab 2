1.highest value number or low value
sum<- function(a, b, c) {
  result <- a + b + c
  if(result > 50) {
    return("High Value")
  } else {
    return("Low Value")
  }
}
x <- sum(60, 20, 30)
print(x)

2. factorial
fact <- function(n) {
  if(n == 1) {
    return(1)
  } else {
    return(n * fact(n-1))
  }
}
result <- fact(5)
print(result)

3.mean and standard deviation
stats_func <- function(x) {
  mean_val <- mean(x)
  sd_val <- sd(x)
  list(mean=mean_val, sd=sd_val)
}
data <- c(10,20,30,40,50)
output <- stats_func(data)
print(output)

4.student marks
grade <- function(marks) {
  if(marks >= 75) {
    return("Distinction")
  } else if(marks >= 50) {
    return("Pass")
  } else {
    return("Fail")
  }
}
print(grade(68))



5.sum of n numbers
sum_func <- function(n) {
  total <- 0
  for(i in 1:n) {
    total <- total + i
  }
  return(total)
}
print(sum_func(10))




6.even count
even_count <- function(x) {
  count <- 0
  for(i in x) {
    if(i %% 2 == 0) {
      count <- count + 1
    }
  }
  return(count)
}
print(even_count(1:20))
